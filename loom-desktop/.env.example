# Copy this file to .env and fill in your key. .env is gitignored — never commit it.
#
# Smart Sort uses this as the DEFAULT Anthropic API key: it's applied only when
# you haven't entered a key in Loom's Settings (a key entered in Settings always
# wins). Handy for development so you don't paste a key every run. This file is
# not bundled into the packaged app, so it's a dev-time convenience only.
#
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
